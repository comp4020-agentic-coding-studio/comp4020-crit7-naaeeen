    <path d="M82 62 202 0v98L82 163Z" class="scene-wall-left" />
    <path d="M202 0 322 62v101L202 98Z" class="scene-wall-right" />
    <path d="m98 72 80-42v60l-80 43V72Z" class="scene-window" />
    <path d="M138 52v61M98 101l80-42" class="scene-window-line" />
    {kind === "room" ? <>
      <path d="m167 109 67-36 50 27-68 38-49-29Z" class="scene-board" />
      <path d="m229 26 66 34v40l-66-34V26Z" class="scene-frame" />
      <path d="m238 43 29 15m-29-5 45 24" class="scene-window-line" />
      <path d="M145 139v28m114-29v28m-57-2v30" class="scene-legs" />
      <path d="m135 136 62-34 73 39-67 38-68-43Z" class="scene-table" />
      <path d="m135 136 68 37 67-32v9l-67 37-68-42v-9Z" class="scene-table-edge" />
      <path d="m172 100-19-10v19l18 10 15-8v-19l-14 8Z" class="scene-chair" />
      <path d="m254 121 17-10v19l-18 10-15-8v-19l16 8ZM167 172l-19-10v19l18 10 15-8v-19l-14 8Z" class="scene-chair" />
      <path d="m192 131 18-9 19 10-18 10-19-11Z" class="scene-book" />
      <path d="m179 141 13-7 13 7-13 7-13-7Z" class="scene-paper" />
    </> : kind === "booth" ? <>
      <path d="m133 112 52-28 70 37-50 29-72-38Z" class="scene-chair" />
      <path d="M133 112v51l72 38v-51l-72-38Z" class="scene-chair-side" />
      <path d="m205 150 50-29v52l-50 28v-51Z" class="scene-chair" />
      <path d="m148 122 37-20 52 28-34 21-55-29Z" class="scene-cushion" />
      <path d="m169 135 38-20 52 28-37 21-53-29Z" class="scene-table" />
