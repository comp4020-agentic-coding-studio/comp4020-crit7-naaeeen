      <path d="m196 135 17-9 16 9-17 9-16-9Z" class="scene-book" />
      <path d="m260 67 27 14v25l-27-14V67Z" class="scene-frame" />
    </> : <>
      <path d="M137 140v36m107-38v37m-53-10v31" class="scene-legs" />
      <path d="m130 133 57-31 68 37-58 31-67-37Z" class="scene-table" />
      <path d="m130 133 67 37 58-31v8l-58 31-67-37v-8Z" class="scene-table-edge" />
      <path d="m190 105 34 18v27l-34-18v-27Z" class="scene-monitor" />
      <path d="m196 114 22 12v14l-22-12v-14Z" class="scene-screen" />
      <path d="m172 141 19-10 20 11-19 10-20-11Z" class="scene-paper" />
      <path d="m163 176-22-12v21l21 12 17-9v-21l-16 9Z" class="scene-chair" />
      <path d="m248 37 34 18v37l-34-18V37Z" class="scene-frame" />
    </>}
    <path d="M290 141v29" class="scene-legs" />
    <path d="M279 156h23l-4 24h-15l-4-24Z" class="scene-pot" />
    <path d="M290 153c-20-5-23-22-19-27 14 0 20 14 19 27Zm1-12c-2-24 9-29 18-30 5 14-5 28-18 30Z" class="scene-leaf" />
  </svg>
  <span class="scene-index">{kind === "room" ? "A place to come together" : kind === "booth" ? "A corner of your own" : "Room for your next idea"}</span>
</div>
