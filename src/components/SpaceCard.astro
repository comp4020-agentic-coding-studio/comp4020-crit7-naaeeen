---
import type { AvailabilityItem, SearchFilters } from "../lib/types";
import Icon from "./Icon.astro";
import RoomScene from "./RoomScene.astro";
import { displayTime, featureIcon, featureLabel, kindLabels, searchParams } from "./format";
interface Props { item: AvailabilityItem; filters: SearchFilters; index: number; }
const { item, filters, index } = Astro.props;
const { space } = item;
const detailsUrl = `/spaces/${encodeURIComponent(space.id)}/?${searchParams(filters)}`;
---
<article class:list={["space-card", { "space-card-busy": !item.available }]} style={`--reveal-index:${Math.min(index, 5)}`} data-space-id={space.id}>
  <div class="card-visual">
    <RoomScene kind={space.kind} variant={index} />
    <span class="kind-label">{kindLabels[space.kind]}</span>
  </div>
  <div class="card-body">
    <p class="card-location">{space.library}<span aria-hidden="true"> / </span>{space.floor}</p>
    <div class="card-title-row"><h3><a href={detailsUrl}>{space.name}</a></h3><span class="capacity" aria-label={`Fits ${space.capacity} ${space.capacity === 1 ? "person" : "people"}`}><Icon name="people" size={16} />{space.capacity}</span></div>
    <ul class="feature-list" aria-label="Facilities">{space.features.slice(0, 3).map((feature) => <li><Icon name={featureIcon(feature)} size={15} />{featureLabel(feature)}</li>)}</ul>
    <div class="card-availability">
      <span class:list={["availability-label", { "availability-busy": !item.available }]}><span class="status-dot" />{item.available ? "Available for your whole session" : "Taken for part of your session"}</span>
      <p>{displayTime(item.start)} <span aria-hidden="true">—</span><span class="sr-only">to</span> {displayTime(item.end)}</p>
    </div>
    {item.available ? <a class="button button-card" href={detailsUrl}>Review &amp; book <Icon name="arrow" size={18} /></a> : <div class="alternative-times"><span>Try a nearby time</span>{item.alternatives.length > 0 ? <div>{item.alternatives.slice(0, 2).map((alternative) => <a href={`/spaces/${encodeURIComponent(space.id)}/?${searchParams({ ...filters, date: alternative.date, start: alternative.start })}`} aria-label={`Review ${space.name} at ${displayTime(alternative.start)}`}>{displayTime(alternative.start)}<Icon name="diagonal" size={13} /></a>)}</div> : <a href="#space-search">Change your time <Icon name="arrow" size={14} /></a>}</div>}
  </div>
</article>
