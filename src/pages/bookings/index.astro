---
import SiteLayout from "../../layouts/SiteLayout.astro";
import Icon from "../../components/Icon.astro";
import BookingRules from "../../components/BookingRules.astro";
import { displayDate, displayTime, durationLabel } from "../../components/format";
import { getErrorMessage } from "../../components/messages";
import { listBookings, getBookingAllowance, todayInCanberra } from "../../lib/booking";

const bookings = listBookings(Astro.locals.bookingOwner);
const allowance = getBookingAllowance(Astro.locals.bookingOwner, todayInCanberra());
const confirmed = bookings.filter((booking) => booking.status === "confirmed");
const cancelled = bookings.filter((booking) => booking.status === "cancelled");
const created = confirmed.find((booking) => booking.id === Astro.url.searchParams.get("created"));
const justCancelled = cancelled.find((booking) => booking.id === Astro.url.searchParams.get("cancelled"));
const error = getErrorMessage(Astro.url.searchParams.get("error"));
Astro.response.headers.set("Cache-Control", "no-store");
---
<SiteLayout title="My bookings" current="bookings">
  <div class="shell bookings-page">
    <header class="bookings-heading"><div><p class="eyebrow">A little space, saved for you</p><h1>My bookings<span class="heading-dot">.</span></h1><p>Your plans, all in one place. Saved for this browser.</p></div><a class="button button-outline" href="/">Find another space <Icon name="arrow" size={18} /></a></header>
    {created && <section class="success-panel" role="status"><span class="success-mark" aria-hidden="true"><svg viewBox="0 0 36 36" fill="none"><path d="m9 18 6 6L27 11" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg></span><div><p class="eyebrow">All yours</p><h2>You’re booked in.</h2><p>{created.space.name} is saved for {displayDate(created.date)}, {displayTime(created.start)}–{displayTime(created.end)}.</p><p class="success-reference">Your reference <strong>{created.reference}</strong></p></div><span class="success-decoration" aria-hidden="true">See you<br /><em>there.</em></span></section>}
    {justCancelled && <div class="notice notice-success" role="status"><Icon name="check" /><div><strong>Booking cancelled. Thanks for making room.</strong><p>{justCancelled.space.name} on {displayDate(justCancelled.date)} is available to book again.</p></div></div>}
    {error && <div class="notice notice-error" role="alert"><Icon name="info" /><p>{error}</p></div>}
    <BookingRules allowance={allowance} context="bookings" />
    <section aria-labelledby="confirmed-heading"><div class="booking-section-heading"><h2 id="confirmed-heading">Your sessions <span>{confirmed.length}</span></h2><p>Demo bookings · Canberra time</p></div>
    {confirmed.length > 0 ? <div class="booking-list">{confirmed.map((booking, index) => <article class:list={["booking-card", { "just-created": created?.id === booking.id }]} style={`--reveal-index:${Math.min(index, 5)}`}><div class="booking-date-block"><span>{displayDate(booking.date).split(",")[0]}</span><strong>{Number(booking.date.slice(8))}</strong><span>{new Intl.DateTimeFormat("en-AU", {month: "short",timeZone:"UTC"}).format(new Date(`${booking.date}T12:00:00Z`))}</span></div><div class="booking-card-main"><div class="booking-topline"><p class="card-location">{booking.space.library} / {booking.space.floor}</p><span class="booking-status"><span class="status-dot" />Confirmed</span></div><h3>{booking.space.name}</h3><ul class="booking-facts"><li><Icon name="clock" size={16} />{displayTime(booking.start)}–{displayTime(booking.end)}<span class="duration-quiet"> · {durationLabel(booking.duration)}</span></li><li><Icon name="people" size={16} />{booking.people} {booking.people === 1 ? "person" : "people"}</li></ul><div class="booking-bottomline"><p>Reference <strong>{booking.reference}</strong></p>{booking.canCancel ? <details class="cancel-details"><summary>Cancel booking</summary><div class="cancel-confirmation"><p>Release this space for someone else? This cannot be undone.</p><form method="post" action={`/api/bookings/${encodeURIComponent(booking.id)}/cancel`} data-cancel-form><button class="button button-cancel" type="submit">Yes, cancel booking</button></form><button class="text-button" type="button" data-keep-booking hidden>Keep my booking</button></div></details> : <span class="ended-note">Cancellation is no longer available.</span>}</div></div></article>)}</div> : <div class="empty-state bookings-empty"><span class="empty-symbol" aria-hidden="true"><Icon name="bookmark" size={30} /></span><h3>Your next idea needs a little room.</h3><p>No confirmed bookings here yet. Find a space for some quiet focus, a catch-up or the whole group.</p><a class="button button-primary" href="/">Find my space <Icon name="arrow" size={18} /></a></div>}
    </section>
    {cancelled.length > 0 && <details class="cancelled-history"><summary>Cancelled bookings <span>{cancelled.length}</span></summary><ul>{cancelled.map((booking) => <li><div><strong>{booking.space.name}</strong><p>{booking.space.library} · {displayDate(booking.date)} · {displayTime(booking.start)}–{displayTime(booking.end)}</p></div><span>Cancelled</span></li>)}</ul></details>}
    <aside class="browser-note"><Icon name="info" size={19} /><p>Bookings stay linked to this browser. Clearing site cookies or switching devices means these bookings will not appear here. These are demo reservations and do not reserve real ANU spaces.</p></aside>
  </div>
</SiteLayout>
