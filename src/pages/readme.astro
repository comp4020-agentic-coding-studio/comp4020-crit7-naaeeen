---
import * as readme from "../../README.md";
import SiteLayout from "../layouts/SiteLayout.astro";
import Icon from "../components/Icon.astro";
const title = readme.getHeadings().find((heading) => heading.depth === 1)?.text ?? "About this project";
const html = (await readme.compiledContent()).replace(/(src|href)="public\//g, '$1="/');
---
<SiteLayout title={title} current="about">
  <div class="shell about-page"><a class="back-link" href="/"><Icon name="back" size={18} />Find a space</a><article class="prose" set:html={html} /></div>
</SiteLayout>
